# ── OpenAI ────────────────────────────────────────────────────────────────
# Ne partage jamais cette clé et ne l'ajoute jamais à Git.
OPENAI_API_KEY=colle_ta_nouvelle_cle_ici

# Modèle de conversation.
OPENAI_MODEL=gpt-5

# Modèle utilisé quand la recherche Web est activée.
OPENAI_SEARCH_MODEL=gpt-5.6-luna

# Modèle de l'extraction de profil (appel court et bon marché).
# Par défaut : OPENAI_MODEL.
# OPENAI_EXTRACTION_MODEL=

# ── API Oriente (FastAPI) ─────────────────────────────────────────────────
# Profil, historique de conversation, catalogue sourcé et recommandations.
# Lance-la avant le bot :  cd apps/api && uvicorn app.main:app
#
# Si elle est absente, le bot démarre quand même en mode dégradé : il le dit
# au démarrage, et le prompt interdit alors au modèle d'inventer un catalogue.
ORIENTE_API_URL=http://localhost:8000

# Délai au-delà duquel un appel à l'API est abandonné (ms).
# Au-dessus de ~8000, l'utilisateur WhatsApp croit que le bot est mort.
ORIENTE_API_TIMEOUT_MS=5000
